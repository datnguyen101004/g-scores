# Host connection. Docker maps host port 5433 to PostgreSQL's container port 5432.
DB_HOST=localhost
DB_PORT=5433
# Backend container port on the host. Use another port if local Spring Boot is running.
BACKEND_PORT=8080
POSTGRES_DB=g_scores
POSTGRES_USER=g_scores
# Replace with a unique password before starting the database.
POSTGRES_PASSWORD=replace_with_a_unique_password
# These initialization values only apply when the PostgreSQL volume is empty.

# Dedicated local Redis; 6379 may already belong to another project.
REDIS_HOST=localhost
REDIS_PORT=6380
# Cached reports expire after one hour. Positive number of seconds.
CACHE_TTL_SECONDS=3600
